# =============================================================================
# mobile-network-traffic-forecasting — Git ignore rules
# Keep: src/, scripts/, notebooks/, docs/, report/, README, requirements,
#       small final metrics/figures needed to understand the experiment.
# Ignore: raw/large data, caches, secrets, temp extracts, model weights,
#         and regenerable intermediate artefacts.
# =============================================================================

# --- Large datasets and archives ---
data/raw/*
!data/raw/README.md
data/processed/*
!data/processed/.gitkeep
data/samples/*
!data/samples/.gitkeep
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
*.gz
*.bz2
*.xz

# Extracted Milan daily TXT dumps (if created outside tmp/)
sms-call-internet-*.txt
**/sms-call-internet-*.txt

# --- Generated / temporary data files (global safety net) ---
# Large tabular dumps anywhere in the repo. Small final metric tables under
# results/metrics/ are re-included below.
*.csv
*.tsv
*.parquet
*.feather
*.h5
*.hdf5
*.pkl
*.pickle
*.npy
*.npz
*.arrow
*.jsonl
*.sqlite
*.db

# --- Temporary extraction / working directories ---
tmp/
temp/
.tmp/
.temp/
extract/
extracted/
unzipped/

# Local Drive/Colab working trees if synced into the project folder
milan_traffic/
content/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-wheel-metadata/
share/python-wheels/

# --- Virtual environments ---
.env/
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# --- Jupyter ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
*.ipynb_checkpoints

# Local screen-recording / presentation notebook (large embedded outputs)
notebooks/phase6c_presentation.ipynb

# --- Secrets and environment files ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials.json
service-account*.json

# --- Model checkpoints and large artefacts ---
*.pt
*.pth
*.ckpt
*.onnx
*.pb
*.joblib
*.safetensors
checkpoints/
saved_models/
weights/
models/checkpoints/
*.keras
*.tfindex
*.data-00000-of-00001

# --- OS files ---
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- IDE / editor ---
.idea/
.vscode/
*.swp
*.swo
*~
.project
.settings/
*.sublime-project
*.sublime-workspace

# --- Testing / coverage / logs ---
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
nosetests.xml
coverage.xml
*.log
logs/

# --- Machine-specific / local-only config ---
*.local
*.local.*
local_settings.py
paths.local.json
.cursor/

# =============================================================================
# results/ — keep small final metrics & figures; ignore regenerable intermediates
# =============================================================================
# Prediction time-series dumps (can be large; reproducible from evaluation runs)
results/predictions/*
!results/predictions/.gitkeep
results/metrics/phase6c_predictions/
results/metrics/**/predictions/

# Re-include small final metric CSVs (global *.csv would otherwise hide them).
# JSON / Markdown / PNG under results/ are not globally ignored.
!results/metrics/*.csv

# Do not re-include any prediction CSVs nested under metrics
results/metrics/phase6c_predictions/**
